-- PLATFORM FOLLOW + DODGE TIMER
-- =========================================

table.insert(connections,
    RunService.Heartbeat:Connect(function()
        if not running or not skyOn or not platform then
            return
        end

        local root = getRoot()
        if not root then return end

        if dodgeTarget then
            if os.clock() >= dodgeUntil then
                returnHome()
            else
                local desired = Vector3.new(
                    dodgeTarget.X,
                    standingY(),
                    dodgeTarget.Z
                )

                if (root.Position - desired).Magnitude > 1 then
                    root.CFrame = CFrame.new(desired)
                end

                if dodgePlatform then
                    dodgePlatform.Position = Vector3.new(
                        dodgeTarget.X,
                        platformY(),
                        dodgeTarget.Z
                    )
                end
            end
        else
            -- Original V2 platform follow
            platform.Position = Vector3.new(
                root.Position.X,
                platform.Position.Y,
                root.Position.Z
            )
        end
    end)
)

