        local state = getter()

        button.Text =
            label .. ": " .. (state and "ON" or "OFF")

        button.BackgroundColor3 = state
            and Color3.fromRGB(35, 145, 75)
            or Color3.fromRGB(150, 45, 45)
    end

    table.insert(connections,
        button.MouseButton1Click:Connect(function()
            setter(not getter())
            refresh()
        end)
    )

    refresh()
end

