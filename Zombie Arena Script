local function stop()
    if not running then return end
    running = false

    killOn = false
    skyOn = false
    buyOn = false
    equipOn = false
    bossDodgeOn = false
    rockDodgeOn = false

    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    removePlatform()

    if gui then
        gui:Destroy()
    end

    _G.ZombieAllInOneStop = nil
    _G.ZombieBossDodgeStop = nil

    print("Zombie Arena V4 stopped.")
end

