local function normalize(s)
    return tostring(s):upper():gsub("[^%w]", "")
end

local function getRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function flat(v)
    return Vector3.new(v.X, 0, v.Z)
end

local function direction(v)
    local f = flat(v)
    if f.Magnitude < 0.01 then
        return Vector3.new(1, 0, 0)
    end
    return f.Unit
end

local function getVector(v)
    if typeof(v) == "Vector3" then
        return v
    end

    if type(v) == "table" then
        local x = v.X or v.x or v[1]
        local y = v.Y or v.y or v[2]
        local z = v.Z or v.z or v[3]

        if type(x) == "number"
            and type(y) == "number"
            and type(z) == "number" then
            return Vector3.new(x, y, z)
        end
    end
end

-- =========================================
-- ORIGINAL WEAPON DETECTION
-- =========================================

local function getBestWeapon()
    local character = player.Character
    local backpack = player:FindFirstChild("Backpack")
    local tools = {}

    for _, container in ipairs({character, backpack}) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    table.insert(tools, item)
                end
            end
        end
    end

    local function find(name)
        local wanted = normalize(name)

        for _, tool in ipairs(tools) do
            if normalize(tool.Name) == wanted then
                return tool
            end
        end
    end

    return find("SCAR-H")
        or find("P90")
        or find("Pistol")
        or find("ShotGun")
        or find("Rifle")
        or find("Minigun")
        or tools[1]
end

local function equipBest()
    if not equipOn then return end

    local character = player.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    if not humanoid then return end

    local target = getBestWeapon()

    if target and target.Parent ~= character then
        pcall(function()
            humanoid:EquipTool(target)
        end)
    end
end

local function currentWeapon()
    local character = player.Character

    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then
                return item.Name
            end
        end
    end

    local best = getBestWeapon()
    return best and best.Name or "Pistol"
end

local function getNextUpgrade()
    local main = playerGui:FindFirstChild("MainGui")
    local panel = main and main:FindFirstChild("ControlPanel2")
    local nextUp = panel and panel:FindFirstChild("NextUpgrade")
    local label = nextUp
        and nextUp:FindFirstChild("DescriptionLabel")

    return label and label.Text or ""
end

-- =========================================
-- SKY PLATFORM
-- =========================================

local function standingY()
    return home and (home.Y + SKY_HEIGHT)
end

local function platformY()
    return standingY() - 3.5
end

local function createPlatform(name, x, z)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = Vector3.new(18, 1, 18)
    p.Anchored = true
    p.CanCollide = true
    p.CanTouch = false
    p.Transparency = 1
    p.Position = Vector3.new(x, platformY(), z)
    p.Parent = workspace
    return p
end

local function removeDodgePlatform()
    if dodgePlatform then
        dodgePlatform:Destroy()
        dodgePlatform = nil
    end
end

local function removePlatform()
    if platform then
        platform:Destroy()
        platform = nil
    end

    removeDodgePlatform()
    dodgeTarget = nil
    dodgeUntil = 0
    dodgeReason = "None"
end

local function teleportTo(x, z)
    local root = getRoot()
    if root and home then
        root.CFrame = CFrame.new(
            x,
            standingY(),
            z
        )
    end
end

local function makePlatform()
    removePlatform()

    local root = getRoot()
    if not root then return end

    home = root.Position

    platform = createPlatform(
        "ZombieSkyPlatform",
        home.X,
        home.Z
    )

    teleportTo(home.X, home.Z)
end

local function returnHome()
    if home and skyOn then
        teleportTo(home.X, home.Z)
    end

    dodgeTarget = nil
    dodgeUntil = 0
    dodgeReason = "None"

    removeDodgePlatform()
end

local function updateHeight()
    if not home then return end

    if platform then
        platform.Position = Vector3.new(
            home.X, platformY(), home.Z
        )
    end

    if dodgePlatform and dodgeTarget then
        dodgePlatform.Position = Vector3.new(
            dodgeTarget.X,
            platformY(),
            dodgeTarget.Z
        )
    end

    if skyOn then
        local target = dodgeTarget or home
        teleportTo(target.X, target.Z)
    end
end

-- =========================================
-- SHARED DODGE SYSTEM
-- =========================================

local function startDodge(target, duration, reason)
    if not running or not skyOn then return end
    if not home or not platform then return end

    local endTime = os.clock() + duration

    -- Extend dodge duration when attacks overlap.
    dodgeUntil = math.max(dodgeUntil, endTime)

    dodgeTarget = Vector3.new(
        target.X,
        standingY(),
        target.Z
    )

    dodgeReason = reason

    removeDodgePlatform()

    dodgePlatform = createPlatform(
        "ZombieTemporaryDodgePlatform",
        dodgeTarget.X,
        dodgeTarget.Z
    )

    teleportTo(dodgeTarget.X, dodgeTarget.Z)

    print(
        "[AUTO DODGE]",
        reason,
        "Hold:",
        math.max(0, dodgeUntil - os.clock())
    )
end

-- =========================================
-- ROCK AUTO DODGE
-- Packet:
-- {ZombieId, StartX, StartY, StartZ,
--  TargetX, TargetY, TargetZ, TravelTime}
-- =========================================

local function handleRockPacket(packet)
    if not running or not rockDodgeOn or not skyOn then
        return
    end

    if type(packet) ~= "table" then return end

    -- Handle nested event packets
    if type(packet[1]) == "table" then
        for _, entry in pairs(packet) do
            handleRockPacket(entry)
        end
        return
    end

    local id = tonumber(packet[1])

    local sx = tonumber(packet[2])
    local sy = tonumber(packet[3])
    local sz = tonumber(packet[4])

    local tx = tonumber(packet[5])
    local ty = tonumber(packet[6])
    local tz = tonumber(packet[7])

    local flight = tonumber(packet[8])

    if not (sx and sy and sz and tx and ty and tz) then
        return
    end

    local root = getRoot()
    if not root or not home or not platform then
        return
    end

    local startPos = Vector3.new(sx, sy, sz)
    local targetPos = Vector3.new(tx, ty, tz)

    -- Use actual current dodge position if already dodging.
    local currentPos = dodgeTarget or root.Position

    local horizontalDistance =
        flat(currentPos - targetPos).Magnitude

    local verticalDistance =
        math.abs(currentPos.Y - targetPos.Y)

    -- Check whether the rock is aimed near us.
    if horizontalDistance > ROCK_RADIUS
        or verticalDistance > 12 then
        return
    end

    -- Move perpendicular to incoming projectile.
    local incoming = direction(targetPos - startPos)

    local right = Vector3.new(
        -incoming.Z,
        0,
        incoming.X
    )

    local side = flat(currentPos - startPos):Dot(right)

    local dodgeDir = right * (side >= 0 and 1 or -1)

    -- Move farther than the expected impact area.
    local target = currentPos
        + dodgeDir * ROCK_DODGE_DISTANCE

    -- If already dodging, do not shorten the hold.
    local duration = math.clamp(
        (flight or 1.5) + ROCK_EXTRA_TIME,
        0.8,
        8
    )

    rocksDodged += 1

    startDodge(
        target,
        duration,
        "ROCK | Zombie " .. tostring(id or "?")
    )
end

local rockRemote =
    zombieRemotes:WaitForChild("ZombieRockThrow")

table.insert(connections,
    rockRemote.OnClientEvent:Connect(function(...)
        local args = table.pack(...)

        for i = 1, args.n do
            handleRockPacket(args[i])
        end
    end)
)

-- =========================================
-- BOSS AUTO DODGE
-- =========================================

local function handleBossAbility(data)
    if not running or not bossDodgeOn or not skyOn then
        return
    end

    if type(data) ~= "table" then return end
    if data.Phase ~= "Telegraph" then return end

    local cast = data.Cast
    if type(cast) ~= "table" then return end

    local root = getRoot()
    if not root or not home then return end

    local origin = getVector(cast.Origin)
    if not origin then return end

    local ability = tostring(
        data.AbilityId or "Unknown"
    )

    local radius = tonumber(cast.Radius)
        or tonumber(cast.MaximumRadius)

    if not radius then
        warn("[BOSS DODGE] Unknown shape:", ability)
        return
    end

    local playerPos = dodgeTarget or root.Position
    local distance =
        flat(playerPos - origin).Magnitude

    if distance > radius + 4 then
        return
    end

    local dodgeDir = direction(playerPos - origin)

    if ability == "BoxerBarrage" then
        local facing = getVector(cast.FacingPosition)

        if facing then
            local forward = direction(facing - origin)
            local right = Vector3.new(
                -forward.Z,
                0,
                forward.X
            )

            local side =
                flat(playerPos - origin):Dot(right)

            dodgeDir = right
                * (side >= 0 and 1 or -1)
        end
    end

    local travel = math.max(
        12,
        radius + 8 - distance
    )

    local target = playerPos + dodgeDir * travel

    local duration = 2

    if type(cast.RecoveryEndAt) == "number"
        and type(data.ServerTime) == "number" then

        duration = math.max(
            0.5,
            cast.RecoveryEndAt
                - data.ServerTime
                + 0.25
        )
    end

    bossesDodged += 1

    startDodge(
        target,
        duration,
        "BOSS | " .. ability
    )
end

