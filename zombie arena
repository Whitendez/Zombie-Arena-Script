end))

local function handleBossAbility(data)
    if not running or not bossDodgeOn or not skyOn then return end
    if type(data)~="table" or data.Phase~="Telegraph" then return end
    local cast=data.Cast
    if type(cast)~="table" then return end
    local root=getRoot()
    if not root or not home then return end
    local origin=getVector(cast.Origin)
    if not origin then return end
    local ability=tostring(data.AbilityId or "Unknown")
    local radius=tonumber(cast.Radius) or tonumber(cast.MaximumRadius)
    if not radius then warn("[BOSS DODGE] Unknown shape:",ability);return end
    local playerPos=dodgeTarget or root.Position
    local distance=flat(playerPos-origin).Magnitude
    if distance>radius+4 then return end
    local dodgeDir=direction(playerPos-origin)
    if ability=="BoxerBarrage" then
        local facing=getVector(cast.FacingPosition)
        if facing then
            local forward=direction(facing-origin)
            local right=Vector3.new(-forward.Z,0,forward.X)
            local side=flat(playerPos-origin):Dot(right)
            dodgeDir=right*(side>=0 and 1 or -1)
        end
    end
    local travel=math.max(12,radius+8-distance)
    local target=playerPos+dodgeDir*travel
    local duration=2
    if type(cast.RecoveryEndAt)=="number" and type(data.ServerTime)=="number" then
        duration=math.max(0.5,cast.RecoveryEndAt-data.ServerTime+0.25)
    end
    registerThreat(origin,duration,radius)
    bossesDodged+=1
    startDodge(target,duration,"BOSS | "..ability)
end
