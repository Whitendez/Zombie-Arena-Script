-- Original V4 kill aura preserved.
task.spawn(function()
    local cursor=1
    while running do
        task.wait(ATTACK_INTERVAL)
        if not killOn then continue end
        local zombies={}
        for _,model in ipairs(zombieFolder:GetChildren()) do
            local root=model:FindFirstChild("HumanoidRootPart")
            if root then
                local id=tonumber(model.Name:match("(%d+)$"))
                if id then table.insert(zombies,{id=id,root=root}) end
            end
        end
        if #zombies==0 then cursor=1;continue end
        local weapon=currentWeapon()
        local hits=math.min(MAX_HITS,#zombies)
        for i=1,hits do
            if not running or not killOn then break end
            if cursor>#zombies then cursor=1 end
            local zombie=zombies[cursor]
            cursor+=1
            if zombie.root.Parent then
                pcall(function()
                    gunHit:FireServer(weapon,zombie.id,zombie.root.Position)
                end)
            end
        end
    end
end)
-- Original V4 auto-buy preserved.
task.spawn(function()
    while running do
        task.wait(BUY_INTERVAL)
        if not buyOn then continue end
        local nextUpgrade=getNextUpgrade()
        local normalized=normalize(nextUpgrade)
        if normalized:find("P90",1,true) or normalized:find("SCARH",1,true) then
            lastUpgrade=nextUpgrade
            pcall(function()weaponBuy:FireServer() end)
        elseif nextUpgrade~="" then
            healthUnlocked=true
        end
        if healthUnlocked then
            lastUpgrade="Health upgrades"
            pcall(function()healthBuy:FireServer() end)
        end
    end
end)
