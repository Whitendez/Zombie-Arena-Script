local AutoShoot = {}

function AutoShoot.Release()
	if not State.MouseHeld then
		return true
	end
	local ok, err = pcall(function()
		VirtualInputManager:SendMouseButtonEvent(State.ShotX, State.ShotY, 0, false, game, 0)
	end)
	if ok then
		State.MouseHeld = false
		return true
	end
	warn("[ZombieArena] Auto Shoot release failed:", err)
	return false
end

function AutoShoot.CanFire()
	if not State.Running or Library.Unloaded or not Toggles.AutoShoot.Value then
		return false
	end
	if State.ChestBusy or (Toggles.AutoChest.Value and findActiveChestPrompt()) then
		return false
	end
	if State.ResetSent or UserInputService:GetFocusedTextBox() then
		return false
	end

	local _, humanoid = getCharacterParts()
	if not humanoid or humanoid.Health <= 0 then
		return false
	end

	local replayBtn = getPlayAgainButton()
	if replayBtn and isGuiVisible(replayBtn) then
		return false
	end

	return true
end

--// 8. Projectile & Boss Packet Handlers \\--
local function handleRockPacket(packet)
	if not State.Running or not Toggles.RockDodge.Value or not Toggles.SkyTP.Value or type(packet) ~= "table" then
		return
	end
	if type(packet[1]) == "table" then
		for _, entry in pairs(packet) do
			handleRockPacket(entry)
		end
		return
	end

	local id = tonumber(packet[1])
	local sx, sy, sz = tonumber(packet[2]), tonumber(packet[3]), tonumber(packet[4])
	local tx, ty, tz = tonumber(packet[5]), tonumber(packet[6]), tonumber(packet[7])
	local flight = tonumber(packet[8])
	if not (sx and sy and sz and tx and ty and tz) then
		return
	end

	local root = getRoot()
	if not root or not State.Home or not State.MainPlatform then
		return
	end

	local startPos = Vector3.new(sx, sy, sz)
	local targetPos = Vector3.new(tx, ty, tz)
	local currentPos = State.DodgeTarget or root.Position

	local rockRadius = Options.RockRadius.Value
	local rockDist = Options.RockDistance.Value

	if flattenVector(currentPos - targetPos).Magnitude > rockRadius
		or math.abs(currentPos.Y - targetPos.Y) > DODGE_TIMING.VerticalTolerance
	then
		return
	end

	local incoming = flatDirection(targetPos - startPos)
	local right = Vector3.new(-incoming.Z, 0, incoming.X)
	local side = flattenVector(currentPos - startPos):Dot(right)
	local dodgeDir = right * (side >= 0 and 1 or -1)

	local duration = math.clamp((flight or 1.5) + DODGE_TIMING.RockExtra, 0.8, 8)
	Dodge.RegisterThreat(targetPos, duration, rockRadius)

	local destination = currentPos + dodgeDir * rockDist
	local safePos = Dodge.FindSafeCandidate(currentPos, rockDist)
	if safePos and flattenVector(safePos - targetPos).Magnitude > flattenVector(destination - targetPos).Magnitude then
		destination = safePos
	end

	State.Stats.RocksDodged += 1
	Dodge.Start(destination, duration, "ROCK | Zombie " .. tostring(id or "?"))
end

-- Packet: { ZombieId, StartX, StartY, StartZ, TargetX, TargetY, TargetZ, TravelTime, ProjectileType, ExtraParam, ZombieType }
local function handleShotPacket(packet)
	if not State.Running or not Toggles.SkyTP.Value or type(packet) ~= "table" then
		return
	end
	if type(packet[1]) == "table" then
		for _, entry in pairs(packet) do
			handleShotPacket(entry)
		end
		return
	end

	local projectile = tostring(packet[9] or "")
	local enemy = tostring(packet[11] or "")
	local isPumpkin = projectile == "PumpkinCannonball" or enemy == "PumpkinGuard"
	local isPirate = projectile == "PirateProjectile" or enemy == "PirateGunner"

	if not isPumpkin and not isPirate then
		return
	end
	if isPumpkin and not Toggles.PumpkinDodge.Value then
		return
	end
	if isPirate and not Toggles.PirateDodge.Value then
		return
	end

	local tx, ty, tz = tonumber(packet[5]), tonumber(packet[6]), tonumber(packet[7])
	local flight = tonumber(packet[8])
	if not (tx and ty and tz and flight) then
		return
	end

	if isPumpkin then
		State.Stats.PumpkinsDetected += 1
	else
		State.Stats.PiratesDetected += 1
	end

	local root = getRoot()
	if not root or not State.Home or not State.MainPlatform then
		return
	end

	local impact = Vector3.new(tx, ty, tz)
	local currentPos = State.DodgeTarget or root.Position
	local radius = isPumpkin and Options.PumpkinRadius.Value or Options.PirateRadius.Value

	if flattenVector(currentPos - impact).Magnitude > radius
		or math.abs(currentPos.Y - impact.Y) > DODGE_TIMING.VerticalTolerance
	then
		return
	end

	local extra = isPumpkin and DODGE_TIMING.PumpkinExtra or DODGE_TIMING.PirateExtra
	local distance = isPumpkin and Options.PumpkinDistance.Value or Options.PirateDistance.Value
	local duration = math.clamp(flight + extra, 0.8, 8)

	Dodge.RegisterThreat(impact, duration, radius)
	local destination = Dodge.FindSafeCandidate(currentPos, distance)
	if not destination then
		return
	end

	if isPumpkin then
		State.Stats.PumpkinsDodged += 1
	else
		State.Stats.PiratesDodged += 1
	end

	local label = isPumpkin and "PUMPKIN" or "PIRATE"
	Dodge.Start(destination, duration, label .. " | " .. tostring(packet[1] or "?"))
end

local function handleBossAbility(data)
	if not State.Running or not Toggles.SkyTP.Value or not State.Home or not State.MainPlatform then
		return
	end
	if type(data) ~= "table" or data.Phase ~= "Telegraph" then
		return
	end

	local cast = data.Cast
	local root = getRoot()
	if type(cast) ~= "table" or not root then
		return
	end

	local currentPos = State.DodgeTarget or root.Position

	-- Flying Dutchman Soul Cannon (multi-target AoE)
	if data.AbilityId == "FlyingDutchmanSoulCannon" then
		if not Toggles.SoulDodge.Value then
			return
		end

		local radius = tonumber(cast.Radius) or 9
		local duration = 1.5
		if type(cast.RecoveryEndAt) == "number" and type(data.ServerTime) == "number" then
			duration = math.max(duration, cast.RecoveryEndAt - data.ServerTime + 0.4)
		end

		local targets = {}
		if type(cast.TargetPositions) == "table" then
			for _, raw in pairs(cast.TargetPositions) do
				local pos = parseVector3(raw)
				if pos then
					table.insert(targets, pos)
				end
			end
		end
		if #targets == 0 then
			local facing = parseVector3(cast.FacingPosition)
			if facing then
				table.insert(targets, facing)
			end
		end

		local inDanger = false
		for _, pos in ipairs(targets) do
			Dodge.RegisterThreat(pos, duration, radius + 4)
			if flattenVector(currentPos - pos).Magnitude <= radius + 4 then
				inDanger = true
			end
		end

		if inDanger then
			local destination = Dodge.FindSafeCandidate(currentPos, 25)
			if destination then
				State.Stats.BossesDodged += 1
				Dodge.Start(destination, duration, "SOUL CANNON")
			end
		end
		return
	end

	-- Standard Boss Telegraphs
	if not Toggles.BossDodge.Value then
		return
	end

	local origin = parseVector3(cast.Origin)
	if not origin then
		return
	end

	local ability = tostring(data.AbilityId or "Unknown")
	local radius = tonumber(cast.Radius) or tonumber(cast.MaximumRadius)
	if not radius then
		warn("[ZombieArena] Unknown boss ability shape:", ability)
		return
	end

	local distToOrigin = flattenVector(currentPos - origin).Magnitude
	if distToOrigin > radius + 4 then
		return
	end

	local dodgeDir = flatDirection(currentPos - origin)
	if ability == "BoxerBarrage" then
		local facing = parseVector3(cast.FacingPosition)
		if facing then
			local forward = flatDirection(facing - origin)
			local right = Vector3.new(-forward.Z, 0, forward.X)
			local side = flattenVector(currentPos - origin):Dot(right)
			dodgeDir = right * (side >= 0 and 1 or -1)
		end
	end

	local travel = math.max(12, radius + 8 - distToOrigin)
	local duration = 2
	if type(cast.RecoveryEndAt) == "number" and type(data.ServerTime) == "number" then
		duration = math.max(0.5, cast.RecoveryEndAt - data.ServerTime + 0.25)
	end

	Dodge.RegisterThreat(origin, duration, radius)

	local destination = currentPos + dodgeDir * travel
	if not Dodge.IsPositionSafe(destination) then
		local safer = Dodge.FindSafeCandidate(currentPos, travel)
		if safer then
			destination = safer
		end
	end

	State.Stats.BossesDodged += 1
	Dodge.Start(destination, duration, "BOSS | " .. ability)
end

