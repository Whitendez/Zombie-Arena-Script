--// 4. Utility Helpers \\--
local function trackConnection(conn)
	table.insert(State.Connections, conn)
	return conn
end

local function normalizeName(str)
	return tostring(str):upper():gsub("[^%w]", "")
end

local function getCharacterParts()
	local character = LocalPlayer.Character
	if not character then
		return nil, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	return character, humanoid, root
end

local function getRoot()
	local character = LocalPlayer.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function flattenVector(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function flatDirection(v)
	local f = flattenVector(v)
	return f.Magnitude < 0.01 and Vector3.new(1, 0, 0) or f.Unit
end

local function parseVector3(value)
	if typeof(value) == "Vector3" then
		return value
	end
	if type(value) == "table" then
		local x = value.X or value.x or value[1]
		local y = value.Y or value.y or value[2]
		local z = value.Z or value.z or value[3]
		if type(x) == "number" and type(y) == "number" and type(z) == "number" then
			return Vector3.new(x, y, z)
		end
	end
	return nil
end

local function isGuiVisible(obj)
	while obj and obj ~= PlayerGui do
		if obj:IsA("GuiObject") and not obj.Visible then
			return false
		end
		if obj:IsA("ScreenGui") and not obj.Enabled then
			return false
		end
		obj = obj.Parent
	end
	return obj == PlayerGui
end

local function getPlayAgainButton()
	local gameOver = PlayerGui:FindFirstChild("GameOver")
	local canvas = gameOver and gameOver:FindFirstChild("ResultsCanvas")
	local stack = canvas and canvas:FindFirstChild("ContentStack")
	return stack and stack:FindFirstChild("PlayAgain")
end

local function findActiveChestPrompt()
	local folder = workspace:FindFirstChild("RaidChests")
	if not folder then
		return nil, nil
	end

	local function extractFromChest(chest)
		local part = chest and chest:FindFirstChild("Part")
		local prompt = part and part:FindFirstChild("RaidChestOpen")
		if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled and part:IsA("BasePart") then
			return prompt, part
		end
		return nil, nil
	end

	local prompt, part = extractFromChest(folder:FindFirstChild("RaidChest"))
	if prompt then
		return prompt, part
	end

	for _, child in ipairs(folder:GetChildren()) do
		prompt, part = extractFromChest(child)
		if prompt then
			return prompt, part
		end
	end

	return nil, nil
end

--// 5. Weapon System \\--
local Weapons = {}

function Weapons.GetAllTools()
	local tools = {}
	for _, container in ipairs({ LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack") }) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") then
					table.insert(tools, item)
				end
			end
		end
	end
	return tools
end

function Weapons.Owns(weaponName)
	local target = normalizeName(weaponName)
	for _, tool in ipairs(Weapons.GetAllTools()) do
		if normalizeName(tool.Name) == target then
			return true
		end
	end
	return false
end

function Weapons.GetBest()
	local tools = Weapons.GetAllTools()
	if #tools == 0 then
		return nil
	end

	local byNormalized = {}
	for _, tool in ipairs(tools) do
		byNormalized[normalizeName(tool.Name)] = tool
	end

	for _, priorityName in ipairs(WEAPON_PRIORITY) do
		local match = byNormalized[normalizeName(priorityName)]
		if match then
			return match
		end
	end

	return tools[1]
end

function Weapons.EquipBest()
	local character, humanoid = getCharacterParts()
	if not character or not humanoid or humanoid.Health <= 0 then
		return false
	end

	local best = Weapons.GetBest()
	if best and best.Parent ~= character then
		pcall(function()
			humanoid:EquipTool(best)
		end)
		return true
	end
	return false
end

function Weapons.GetEquippedName()
	local character = LocalPlayer.Character
	if character then
		for _, item in ipairs(character:GetChildren()) do
			if item:IsA("Tool") then
				return item.Name
			end
		end
	end
	local best = Weapons.GetBest()
	return best and best.Name or "Pistol"
end

--// 6. Sky Platform & Dodge Controller \\--
local Platform = {}

local function getSkyHeight()
	return Options.SkyHeight and Options.SkyHeight.Value or 30
end

function Platform.GetStandingY()
	if not State.Home then
		return nil
	end
	return State.Home.Y + getSkyHeight()
end

function Platform.GetPlatformY()
	local standingY = Platform.GetStandingY()
	return standingY and (standingY - DODGE_TIMING.PlatformOffset) or nil
end

local function createSupportPart(name, x, z)
	local y = Platform.GetPlatformY()
	if not y then
		return nil
	end

	local part = Instance.new("Part")
	part.Name = name
	part.Size = Vector3.new(18, 1, 18)
	part.Anchored = true
	part.CanCollide = true
	part.CanTouch = false
	part.Transparency = 1
	part.Position = Vector3.new(x, y, z)
	part.Parent = workspace
	return part
end

function Platform.TeleportTo(x, z)
	local root = getRoot()
	local y = Platform.GetStandingY()
	if root and y then
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = CFrame.new(x, y, z)
	end
end

function Platform.DestroyDodgePlatform()
	if State.DodgePlatform then
		State.DodgePlatform:Destroy()
		State.DodgePlatform = nil
	end
end

function Platform.ClearDodge()
	State.DodgeTarget = nil
	State.DodgeUntil = 0
	State.DodgeReason = "None"
	Platform.DestroyDodgePlatform()
	table.clear(State.Threats)
end

function Platform.DestroyAll()
	if State.MainPlatform then
		State.MainPlatform:Destroy()
		State.MainPlatform = nil
	end
	Platform.ClearDodge()
end

function Platform.Build(customHome)
	Platform.DestroyAll()
	local root = getRoot()
	if not root and not customHome then
		return
	end

	State.Home = customHome or root.Position
	State.MainPlatform = createSupportPart("ZombieSkyPlatform", State.Home.X, State.Home.Z)
	Platform.TeleportTo(State.Home.X, State.Home.Z)
end

function Platform.ReturnHome()
	if State.Home and Toggles.SkyTP and Toggles.SkyTP.Value then
		Platform.TeleportTo(State.Home.X, State.Home.Z)
	end
	Platform.ClearDodge()
end

function Platform.UpdateHeight()
	if not State.Home then
		return
	end

	local platY = Platform.GetPlatformY()
	if not platY then
		return
	end

	if State.MainPlatform then
		State.MainPlatform.Position = Vector3.new(State.Home.X, platY, State.Home.Z)
	end
	if State.DodgePlatform and State.DodgeTarget then
		State.DodgePlatform.Position = Vector3.new(State.DodgeTarget.X, platY, State.DodgeTarget.Z)
	end
	if Toggles.SkyTP and Toggles.SkyTP.Value then
		local activeTarget = State.DodgeTarget or State.Home
		Platform.TeleportTo(activeTarget.X, activeTarget.Z)
	end
end

local Dodge = {}

function Dodge.PruneThreats()
	local now = os.clock()
	for i = #State.Threats, 1, -1 do
		if State.Threats[i].Expires <= now then
			table.remove(State.Threats, i)
		end
	end
end

function Dodge.RegisterThreat(position, duration, radius)
	Dodge.PruneThreats()
	table.insert(State.Threats, {
		Pos = position,
		Expires = os.clock() + duration,
		Radius = radius,
	})
end

function Dodge.IsPositionSafe(position)
	Dodge.PruneThreats()
	for _, threat in ipairs(State.Threats) do
		if flattenVector(position - threat.Pos).Magnitude <= threat.Radius then
			return false
		end
	end
	return true
end

function Dodge.FindSafeCandidate(origin, distance)
	Dodge.PruneThreats()
	local bestPos, bestScore = nil, -math.huge

	for _, dir in ipairs(CARDINAL_DIRECTIONS) do
		local candidate = origin + dir * distance
		local minClearance = math.huge
		for _, threat in ipairs(State.Threats) do
			local clearance = flattenVector(candidate - threat.Pos).Magnitude - threat.Radius
			if clearance < minClearance then
				minClearance = clearance
			end
		end
		if minClearance > bestScore then
			bestScore = minClearance
			bestPos = candidate
		end
	end

	return bestPos
end

function Dodge.Start(targetPos, duration, reason)
	if not State.Running or not Toggles.SkyTP.Value or not State.Home or not State.MainPlatform then
		return
	end

	local standingY = Platform.GetStandingY()
	if not standingY then
		return
	end

	duration = math.clamp(duration, 0.5, 8)
	State.DodgeUntil = math.max(State.DodgeUntil, os.clock() + duration)
	State.DodgeTarget = Vector3.new(targetPos.X, standingY, targetPos.Z)
	State.DodgeReason = reason

	Platform.DestroyDodgePlatform()
	State.DodgePlatform = createSupportPart("ZombieTemporaryDodgePlatform", State.DodgeTarget.X, State.DodgeTarget.Z)
	Platform.TeleportTo(State.DodgeTarget.X, State.DodgeTarget.Z)
end

