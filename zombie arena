-- Kill Aura
task.spawn(function()
	local cursor = 1
	while State.Running and not Library.Unloaded do
		task.wait(Options.AttackInterval.Value)
		if not Toggles.KillAura.Value then
			continue
		end

		local zombies = {}
		for _, model in ipairs(ZombieFolder:GetChildren()) do
			local root = model:FindFirstChild("HumanoidRootPart")
			if root then
				local id = tonumber(model.Name:match("(%d+)$"))
				if id then
					table.insert(zombies, { Id = id, Root = root })
				end
			end
		end

		if #zombies == 0 then
			cursor = 1
			continue
		end

		local weaponName = Weapons.GetEquippedName()
		local hits = math.min(Options.MaxHits.Value, #zombies)

		for _ = 1, hits do
			if not State.Running or not Toggles.KillAura.Value then
				break
			end
			if cursor > #zombies then
				cursor = 1
			end
			local zombie = zombies[cursor]
			cursor += 1
			if zombie.Root.Parent then
				pcall(function()
					GunHitRemote:FireServer(weaponName, zombie.Id, zombie.Root.Position)
				end)
			end
		end
	end
end)

-- Auto Shoot
task.spawn(function()
	while State.Running and not Library.Unloaded do
		local camera = workspace.CurrentCamera
		if AutoShoot.CanFire() and camera and not State.MouseHeld then
			local center = camera.ViewportSize / 2
			State.ShotX, State.ShotY = center.X, center.Y

			local ok, err = pcall(function()
				VirtualInputManager:SendMouseButtonEvent(State.ShotX, State.ShotY, 0, true, game, 0)
			end)

			if ok then
				State.MouseHeld = true
				local deadline = os.clock() + Options.ShootHoldTime.Value
				repeat
					task.wait(0.05)
				until not State.MouseHeld or not AutoShoot.CanFire() or os.clock() >= deadline
				AutoShoot.Release()
			else
				warn("[ZombieArena] Auto Shoot failed:", err)
				task.wait(2)
			end
		elseif State.MouseHeld then
			AutoShoot.Release()
		end
		task.wait(0.1)
	end
	AutoShoot.Release()
end)

-- Auto Raid Chest
task.spawn(function()
	while State.Running and not Library.Unloaded do
		local prompt, part = findActiveChestPrompt()
		local _, humanoid, root = getCharacterParts()

		if Toggles.AutoChest.Value and prompt and root and humanoid and humanoid.Health > 0 then
			State.ChestBusy = true
			AutoShoot.Release()

			local savedHome = State.Home
			local hadSky = Toggles.SkyTP.Value
			Platform.DestroyAll()

			local ok, err = pcall(function()
				for _ = 1, 5 do
					if not State.Running or not Toggles.AutoChest.Value or not prompt.Parent or not prompt.Enabled then
						break
					end
					if getRoot() ~= root or humanoid.Health <= 0 then
						break
					end

					root.AssemblyLinearVelocity = Vector3.zero
					root.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
					task.wait(0.25)

					if not State.Running or not Toggles.AutoChest.Value or not prompt.Parent or not prompt.Enabled then
						break
					end

					if type(fireproximityprompt) == "function" then
						pcall(fireproximityprompt, prompt)
					end

					if prompt.Parent and prompt.Enabled then
						VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
						task.wait(0.1)
						VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
					end

					task.wait(0.8)
				end
			end)

			if not ok then
				pcall(function()
					VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
				end)
				warn("[ZombieArena] Auto Chest failed:", err)
			end

			if State.Running and getRoot() == root and humanoid.Health > 0 and hadSky and Toggles.SkyTP.Value then
				Platform.Build(savedHome)
			end

			State.ChestBusy = false
			task.wait(1)
		end

		task.wait(0.2)
	end
end)

