-- Shared ZombieShoot handler: PumpkinGuard and PirateGunner.
-- Packet: {ZombieId,StartX,StartY,StartZ,TargetX,TargetY,TargetZ,
--          TravelTime,ProjectileType,ExtraParameter,ZombieType}
local function handleShotPacket(packet)
    if not running or not skyOn or type(packet)~="table" then return end
    if type(packet[1])=="table" then
        for _,entry in pairs(packet) do handleShotPacket(entry) end
        return
    end
    local projectile=tostring(packet[9] or "")
    local enemy=tostring(packet[11] or "")
    local isPumpkin=projectile=="PumpkinCannonball" or enemy=="PumpkinGuard"
    local isPirate=projectile=="PirateProjectile" or enemy=="PirateGunner"
    if not isPumpkin and not isPirate then return end
    if isPumpkin and not pumpkinDodgeOn then return end
    if isPirate and not pirateDodgeOn then return end

    local tx,ty,tz=tonumber(packet[5]),tonumber(packet[6]),tonumber(packet[7])
    local flight=tonumber(packet[8])
    if not (tx and ty and tz and flight) then return end
    if isPumpkin then pumpkinsDetected+=1 else piratesDetected+=1 end

    local root=getRoot()
    if not root or not home or not platform then return end
    local impact=Vector3.new(tx,ty,tz)
    local current=dodgeTarget or root.Position
    local radius=isPumpkin and PUMPKIN_RADIUS or PIRATE_RADIUS
    local distance=flat(current-impact).Magnitude
    if distance>radius or math.abs(current.Y-impact.Y)>12 then return end

    -- Pirate projectiles have been observed reaching the player in ~0.4s.
    -- React on receipt, and hold beyond impact to avoid early return.
    local extra=isPumpkin and PUMPKIN_EXTRA_TIME or PIRATE_EXTRA_TIME
    local duration=math.clamp(flight+extra,0.8,8)
    registerThreat(impact,duration,radius)
    local destination=safeCandidate(current,isPumpkin and PUMPKIN_DISTANCE or PIRATE_DISTANCE)
    if not destination then return end
    if isPumpkin then pumpkinsDodged+=1 else piratesDodged+=1 end
    startDodge(destination,duration,(isPumpkin and "PUMPKIN" or "PIRATE").." | "..tostring(packet[1] or "?"))
end
