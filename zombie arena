local function normalize(s) return tostring(s):upper():gsub("[^%w]", "") end
local function getRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end
local function flat(v) return Vector3.new(v.X, 0, v.Z) end
local function direction(v)
    local f = flat(v)
    return f.Magnitude < 0.01 and Vector3.new(1,0,0) or f.Unit
end
local function getVector(v)
    if typeof(v) == "Vector3" then return v end
    if type(v) == "table" then
        local x,y,z = v.X or v.x or v[1], v.Y or v.y or v[2], v.Z or v.z or v[3]
        if type(x)=="number" and type(y)=="number" and type(z)=="number" then
            return Vector3.new(x,y,z)
        end
    end
end
local function getBestWeapon()
    local tools = {}
    for _, container in ipairs({player.Character, player:FindFirstChild("Backpack")}) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then table.insert(tools,item) end
            end
        end
    end
    local function find(name)
        for _,tool in ipairs(tools) do
            if normalize(tool.Name)==normalize(name) then return tool end
        end
    end
    return find("SCAR-H") or find("P90") or find("Pistol") or find("ShotGun")
        or find("Rifle") or find("Minigun") or tools[1]
end
local function equipBest()
