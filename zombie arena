-- Wave Reset & Auto Replay
local function clickReplayButton(button)
	if not AutoShoot.Release() then
		error("Auto Shoot mouse release failed")
	end

	local pos = button.AbsolutePosition
	local size = button.AbsoluteSize
	local screenGui = button:FindFirstAncestorOfClass("ScreenGui")
	local insetTopLeft = GuiService:GetGuiInset()
	local offsetY = (screenGui and screenGui.IgnoreGuiInset) and 0 or insetTopLeft.Y

	local x = math.floor(pos.X + size.X / 2)
	local y = math.floor(pos.Y + size.Y / 2 + offsetY)

	VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
	task.wait(0.15)
	VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

task.spawn(function()
	while State.Running and not Library.Unloaded do
		if State.ChestBusy or (Toggles.AutoChest.Value and findActiveChestPrompt()) then
			State.MacroStatus = "Collecting raid chest..."
		elseif Toggles.WaveMacro.Value then
			local replayButton = getPlayAgainButton()
			if replayButton and isGuiVisible(replayButton) then
				State.SawResults = true
				if os.clock() - State.LastReplayTime >= 3 then
					State.LastReplayTime = os.clock()
					local ok, err = pcall(clickReplayButton, replayButton)
					State.MacroStatus = ok and "Replay click sent" or "Replay click failed"
					if not ok then
						warn("[ZombieArena] Replay click error:", err)
					end
				end
			else
				if State.SawResults then
					State.ResetSent = false
					State.SawResults = false
				end

				local mainGui = PlayerGui:FindFirstChild("MainGui")
				local waveLabel = mainGui and mainGui:FindFirstChild("WaveLabel")
				local currentWave = waveLabel and tonumber(waveLabel.Text:match("Wave%s+(%d+)"))

				if currentWave then
					State.MacroStatus = string.format("Wave %d / %d", currentWave, State.TargetWave)
					if currentWave >= State.TargetWave and not State.ResetSent then
						local _, humanoid = getCharacterParts()
						if humanoid and humanoid.Health > 0 then
							State.ResetSent = true
							AutoShoot.Release()
							humanoid.Health = 0
						end
					end
					if State.ResetSent then
						State.MacroStatus = "Waiting for results..."
					end
				else
					State.MacroStatus = "Waiting for wave..."
				end
			end
		else
			State.MacroStatus = "Disabled"
		end

		if State.Running and not Library.Unloaded then
			Options.MacroStatusLabel:SetText("Status: " .. State.MacroStatus)
		end
		task.wait(0.25)
	end
end)

