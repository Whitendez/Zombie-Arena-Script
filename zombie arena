trackConnection(RunService.Heartbeat:Connect(function()
	if not State.Running or State.ChestBusy or not Toggles.SkyTP.Value or not State.MainPlatform then
		return
	end

	local root = getRoot()
	if not root then
		return
	end

	Dodge.PruneThreats()

	if State.DodgeTarget then
		if os.clock() >= State.DodgeUntil then
			local homeSafe = true
			for _, threat in ipairs(State.Threats) do
				if flattenVector(State.Home - threat.Pos).Magnitude <= threat.Radius then
					homeSafe = false
					State.DodgeUntil = math.max(State.DodgeUntil, threat.Expires + 0.1)
				end
			end
			if homeSafe then
				Platform.ReturnHome()
			end
		else
			local standingY = Platform.GetStandingY()
			if standingY then
				local desired = Vector3.new(State.DodgeTarget.X, standingY, State.DodgeTarget.Z)
				if (root.Position - desired).Magnitude > 1 then
					root.AssemblyLinearVelocity = Vector3.zero
					root.CFrame = CFrame.new(desired)
				end
			end
			local platY = Platform.GetPlatformY()
			if State.DodgePlatform and platY then
				State.DodgePlatform.Position = Vector3.new(State.DodgeTarget.X, platY, State.DodgeTarget.Z)
			end
		end
	else
		State.MainPlatform.Position = Vector3.new(root.Position.X, State.MainPlatform.Position.Y, root.Position.Z)
	end
end))

