local function shutdown()
	if not State.Running then
		return
	end
	State.Running = false
	AutoShoot.Release()

	for _, conn in ipairs(State.Connections) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	table.clear(State.Connections)

	Platform.DestroyAll()
	_G.ZombieAllInOneStop = nil
	_G.ZombieBossDodgeStop = nil
	print("[ZombieArena] Unloaded cleanly.")
end

Library:OnUnload(shutdown)

local function externalStop()
	if not Library.Unloaded then
		Library:Unload()
	else
		shutdown()
	end
end

_G.ZombieAllInOneStop = externalStop
_G.ZombieBossDodgeStop = externalStop

