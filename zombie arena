local function cleanThreats()
    local now=os.clock()
    for i=#threats,1,-1 do
        if threats[i].expires <= now then table.remove(threats,i) end
    end
end
local function registerThreat(pos, duration, radius)
    cleanThreats()
    table.insert(threats,{pos=pos,expires=os.clock()+duration,radius=radius})
end
local function safeCandidate(current, distance)
    cleanThreats()
    local dirs={
        Vector3.new(1,0,0),Vector3.new(-1,0,0),
        Vector3.new(0,0,1),Vector3.new(0,0,-1),
        Vector3.new(1,0,1).Unit,Vector3.new(-1,0,1).Unit,
        Vector3.new(1,0,-1).Unit,Vector3.new(-1,0,-1).Unit
    }
    local best,score=nil,-math.huge
    for _,dir in ipairs(dirs) do
        local pos=current+dir*distance
        local nearest=math.huge
        for _,threat in ipairs(threats) do
            nearest=math.min(nearest,flat(pos-threat.pos).Magnitude-threat.radius)
        end
        if nearest>score then best=pos;score=nearest end
    end
    return best
end
local function startDodge(target,duration,reason)
    if not running or not skyOn or not home or not platform then return end
    duration=math.clamp(duration,0.5,8)
    dodgeUntil=math.max(dodgeUntil,os.clock()+duration)
    dodgeTarget=Vector3.new(target.X,standingY(),target.Z)
    dodgeReason=reason
    removeDodgePlatform()
    dodgePlatform=createPlatform("ZombieTemporaryDodgePlatform",dodgeTarget.X,dodgeTarget.Z)
    teleportTo(dodgeTarget.X,dodgeTarget.Z)
    print("[AUTO DODGE]",reason,"Hold:",math.max(0,dodgeUntil-os.clock()))
end

local function handleRockPacket(packet)
    if not running or not rockDodgeOn or not skyOn or type(packet)~="table" then return end
    if type(packet[1])=="table" then
        for _,entry in pairs(packet) do handleRockPacket(entry) end
        return
    end
    local id=tonumber(packet[1])
    local sx,sy,sz=tonumber(packet[2]),tonumber(packet[3]),tonumber(packet[4])
    local tx,ty,tz=tonumber(packet[5]),tonumber(packet[6]),tonumber(packet[7])
    local flight=tonumber(packet[8])
    if not (sx and sy and sz and tx and ty and tz) then return end
    local root=getRoot()
    if not root or not home or not platform then return end
    local startPos=Vector3.new(sx,sy,sz)
    local targetPos=Vector3.new(tx,ty,tz)
    local currentPos=dodgeTarget or root.Position
    if flat(currentPos-targetPos).Magnitude>ROCK_RADIUS
        or math.abs(currentPos.Y-targetPos.Y)>12 then return end
    local incoming=direction(targetPos-startPos)
    local right=Vector3.new(-incoming.Z,0,incoming.X)
    local side=flat(currentPos-startPos):Dot(right)
    local dodgeDir=right*(side>=0 and 1 or -1)
    local duration=math.clamp((flight or 1.5)+ROCK_EXTRA_TIME,0.8,8)
    registerThreat(targetPos,duration,ROCK_RADIUS)
    local target=currentPos+dodgeDir*ROCK_DODGE_DISTANCE
    -- Avoid moving into any still-active cannonball/rock impact point.
    local safe=safeCandidate(currentPos,ROCK_DODGE_DISTANCE)
    if safe and flat(safe-targetPos).Magnitude>flat(target-targetPos).Magnitude then target=safe end
    rocksDodged+=1
    startDodge(target,duration,"ROCK | Zombie "..tostring(id or "?"))
end
